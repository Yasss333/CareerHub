# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/resume_builder
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/resume_builder?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/resume_builder?retryWrites=true&w=majority

# Server Configuration
PORT=3000

# JWT Secret (Use a strong random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# OpenAI Configuration
MODEL_NAME=gpt-4o-mini

# ImageKit Configuration (for image uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint

# OpenRouter API Key (for AI features via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Frontend base URL (for axios)
VITE_BASE_URL=http://localhost:3000