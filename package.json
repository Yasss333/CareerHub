{
  "name": "careerhub",
  "version": "1.0.0",
  "description": "Unified Interview Prep Platform - AlgoRank, Resume Builder, AI Mock Interview, Senior Connect",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "seed:api": "npm run prisma:seed --workspace=apps/api",
    "test": "npm run test --workspaces",
    "test:interview": "node --test apps/api/src/routes/interview.routes.test.js apps/api/src/services/interview-evaluation.test.js apps/api/src/services/interview-ml.service.test.js apps/web/tests/interview-analysis.test.mjs apps/api/src/services/interview-report.test.js",
    "test:interview:browser": "node --test --test-concurrency=1 scripts/interview-browser.test.mjs scripts/interview-start-recovery.test.mjs",
    "test:feedback": "node --test apps/api/src/routes/feedback.routes.test.js",
    "test:feedback:database": "node scripts/feedback-database-qa.mjs",
    "test:feedback:browser": "node scripts/feedback-browser-qa.mjs",
    "test:regressions": "node --test apps/api/src/services/mentor-approval.service.test.js scripts/input-validation.test.mjs scripts/slot-time.test.mjs apps/api/tests/server-startup.test.mjs",
    "test:functional:live": "node scripts/functional-qa.mjs",
    "test:functional:browser:live": "node scripts/browser-functional-qa.mjs",
    "test:functional:providers:live": "node scripts/provider-functional-qa.mjs",
    "lint": "npm run lint --workspaces",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules services/*/node_modules",
    "test:admin": "node --test apps/api/src/routes/admin.routes.test.js apps/api/src/services/current-account.test.js",
    "test:interview-admin:browser": "node scripts/interview-admin-browser-qa.mjs",
    "test:notifications": "node --test apps/api/src/services/session-notifications.test.js",
    "test:interview:reliability:browser": "node scripts/interview-reliability-browser-qa.mjs",
    "test:notifications:browser": "node scripts/notification-browser-qa.mjs"
  },
  "dependencies": {
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  }
}
