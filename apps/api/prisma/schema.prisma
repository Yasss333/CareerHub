// CareerHub Unified Prisma Schema
// This schema merges models from AlgoRank, Resume Builder, AI Interview, and Senior Connect

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// UNIFIED USER MODEL (merged from all systems)
// ============================================

enum Role {
  ADMIN
  USER
  MENTOR
}

enum Specialization {
  CS_SOFTWARE
  ELECTRONICS_ELECTRICAL
  OTHER_ENGINEERING
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  role           Role     @default(USER)
  isAlumniMentor Boolean  @default(false)
  mentorApprovalStatus String @default("NONE")
  specialization Specialization?
  
  // Profile fields (merged from all systems)
  name           String?
  image          String?
  
  // AlgoRank ranking fields
  totalProblemsSolved Int      @default(0)
  acceptanceRate      Float    @default(0)
  averageSolveTime    Float?
  currentStreak       Int      @default(0)
  longestStreak       Int      @default(0)
  lastSolvedDate      DateTime?
  rankingScore        Float    @default(0)
  
  // Senior Connect fields
  avatar         String?
  university     String?
  year           String?
  interests      String[]
  goals          Json[]
  title          String?
  company        String?
  location       String?
  credibilityScore Int     @default(0)
  badges         String[]
  timezone       String   @default("UTC")
  
  // AI Interview profile fields
  displayName    String?
  defaultRole    String?
  defaultInterviewLength Int @default(30)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  resumes        Resume[]
  submissions    Submission[]
  interviewSessions InterviewSession[]
  priSnapshots    PriSnapshot[]
  seniorProfile  SeniorProfile?
  sessionBookingsAsJunior SessionBooking[] @relation("JuniorBookings")
  sessionBookingsAsSenior SessionBooking[] @relation("SeniorBookings")
  availabilitySlots AvailabilitySlot[]
  notifications   Notification[]
  feedbackReports FeedbackReport[]
  roadmaps       Roadmap[]
  achievements   Achievement[]
  sessionMessages SessionMessage[]
  
  // AlgoRank relations
  problems      Problem[]
  problemSolved problemSolved[]
  playlist     Playlist[]
  likes         Likes[]
  comments      Comments[]
  nestedComments NestedComments[]
  
  @@index([totalProblemsSolved])
  @@index([rankingScore])
  @@index([lastSolvedDate])
}

// ============================================
// RESUME BUILDER MODELS (MongoDB → Prisma)
// ============================================

model Resume {
  id          String   @id @default(uuid())
  userId      String
  title       String   @default("Untitled-resume")
  public      Boolean  @default(false)
  template    String   @default("classic")
  accentColor String   @default("#3B82F6")
  professionSummary String @default("")
  skills      String[]
  personalInfo Json
  experience  Json[]
  projects    Json[]
  education   Json[]
  profile     String   @default("")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// ALGORANK MODELS (PostgreSQL + Prisma - No Changes)
// ============================================

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Problem {
  id           String     @id @default(uuid())
  title        String
  description  String
  difficulty   Difficulty
  tags         String[]
  userID       String
  examples     Json
  constraints  String
  hints        String?
  editorial    String?
  testcases    Json
  codeSnippets  Json?
  refrenceSolutions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userID], references: [id], onDelete: Cascade)
  submissions Submission[]
  solvedBy problemSolved[]
  problemInplaylist problemsInPlaylist[]
  likes Likes[]
  comments Comments[]
}

model Submission {
  id            String   @id @default(uuid())
  userID        String
  problemID     String
  sourceCode    String
  language      String
  stdin         String?
  stdout        String?
  stderr        String?
  compileOutput String?
  status        String
  memory        String?
  time          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userID], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemID], references: [id])
  testcases Testcases[]
}

model Testcases {
  id            String   @id @default(uuid())
  submissionID  String
  testCase      Int
  passed        Boolean
  stdout        String?
  expected      String?
  stderr        String?
  compileOutput String?
  status        String?
  memory        String?
  time          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submission Submission @relation(fields: [submissionID], references: [id], onDelete: Cascade)

  @@index([submissionID])
}

model problemSolved {
  id        String   @id @default(uuid())
  userID    String
  problemID String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userID], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemID], references: [id], onDelete: Cascade)

  @@unique([userID, problemID])
}

model Playlist {
  id          String   @id @default(uuid())
  title       String
  description String?
  userID      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems problemsInPlaylist[]
  user    User    @relation(fields: [userID], references: [id], onDelete: Cascade)
  @@unique([title,userID])
}

model problemsInPlaylist{
  id          String   @id @default(uuid())
  playlistID String
  problemID String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  playlist Playlist @relation(fields: [playlistID],references: [id],onDelete: Cascade)
  problem Problem @relation(fields: [problemID], references: [id], onDelete: Cascade)
  @@unique([playlistID,problemID])
}

model Likes{
  id String @id @default(uuid())
   userID String
   problemID String

    createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userID] ,references: [id], onDelete: Cascade, onUpdate:Cascade)
  problem Problem @relation(fields: [problemID], references: [id], onDelete: Cascade)

  @@unique([userID,problemID])
}

model Comments{
  id String @id @default(uuid())
  content String
  userID String
  problemID String
   createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userID] ,references: [id], onDelete: Cascade, onUpdate:Cascade)
  problem Problem @relation(fields: [problemID], references: [id], onDelete: Cascade)
  
  nestedComment NestedComments[]
}

model NestedComments{
  id String @id @default(uuid())
  content String
  userID String
  commentID String
     createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comment Comments @relation(fields: [commentID], references: [id],onDelete: Cascade, onUpdate: Cascade)
  user User @relation(fields: [userID] ,references: [id], onDelete: Cascade, onUpdate:Cascade)
  
}

// ============================================
// SENIOR CONNECT MODELS (MongoDB → Prisma)
// ============================================

model SeniorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  title       String
  company     String
  domain      String
  role        String
  bio         String
  experience  Int      @default(0)
  location    String
  expertise   String[]
  achievements String[]
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  sessionCount Int     @default(0)
  availability String   @default("available")
  hourlyRate  Int      @default(0)
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SessionBooking {
  id          String   @id @default(uuid())
  juniorId    String
  seniorId    String
  availabilitySlotId String?
  scheduledTime DateTime
  duration    Int      @default(45)
  topic       String
  notes       String   @default("")
  status      String   @default("pending")
  jitsiRoomName String @default("")
  jitsiRoomUrl  String @default("")
  feedback    Json?
  
  availabilitySlot AvailabilitySlot? @relation(fields: [availabilitySlotId], references: [id])
  feedbacks   SessionFeedback[]
  messages    SessionMessage[]
  
  junior      User     @relation("JuniorBookings", fields: [juniorId], references: [id])
  senior      User     @relation("SeniorBookings", fields: [seniorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([juniorId, createdAt])
  @@index([seniorId, createdAt])
  @@index([availabilitySlotId])
}

model SessionMessage {
  id        String   @id @default(uuid())
  sessionId String
  senderId  String
  message   String
  createdAt DateTime @default(now())

  session   SessionBooking @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// Additional Senior Connect models
model AvailabilitySlot {
  id          String   @id @default(uuid())
  seniorId    String
  date        DateTime
  startTime   String
  endTime     String
  timezone    String   @default("UTC")
  isBooked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  senior      User     @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  bookings    SessionBooking[]
}

model SessionFeedback {
  id          String   @id @default(uuid())
  bookingId   String
  rating      Int
  comment     String
  tags        String[]
  createdAt   DateTime @default(now())

  booking     SessionBooking @relation(fields: [bookingId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  message     String
  data        Json?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model CredibilityScore {
  id          String   @id @default(uuid())
  userId      String   @unique
  score       Int      @default(0)
  factors     Json
  lastUpdated DateTime @default(now())
}

model FeedbackReport {
  id             String   @id @default(uuid())
  userId         String
  requestId      String
  status         String   @default("OPEN")
  payload        Json
  resolutionNote String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ============================================
// AI INTERVIEW MODELS (Supabase → Prisma - Friend Handling)
// ============================================

model InterviewSession {
  id          String   @id @default(uuid())
  userId      String
  type        String   @default("custom")
  topics      String[]
  role        String?
  experienceLevel String?
  difficulty  String   @default("medium")
  plannedDuration Int @default(30)
  cameraEnabled Boolean @default(false)
  cameraConsentAt DateTime?
  microphoneEnabled Boolean @default(false)
  microphoneConsentAt DateTime?
  modalityAvailability Json?
  status      String   @default("in_progress")
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  durationSeconds Int?
  feedback    Json?
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions   InterviewQuestion[]
  emotionResults EmotionResult[]
  proctoringEvents ProctoringEvent[]
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

model InterviewQuestion {
  id          String   @id @default(uuid())
  sessionId   String
  questionText String
  questionIndex Int
  category    String?
  questionType String?
  topic       String?
  difficulty  String?
  expectedAnswerPoints String[] @default([])
  evaluationCriteria String[] @default([])
  answerText  String?
  answeredAt  DateTime?
  questionFeedback Json?
  
  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  emotionResults EmotionResult[]
  createdAt   DateTime @default(now())
  
  @@index([sessionId])
  @@index([questionIndex])
}

model EmotionResult {
  id        String   @id @default(uuid())
  sessionId String
  questionId String?
  modality  String
  result    Json
  createdAt DateTime @default(now())

  session  InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question InterviewQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([questionId])
}

model ProctoringEvent {
  id        String   @id @default(uuid())
  sessionId String
  eventType String
  severity  String   @default("info")
  details   Json?
  createdAt DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model PriSnapshot {
  id             String   @id @default(uuid())
  userId         String
  score          Float
  interviewScore Float
  algoRankScore  Float
  resumeScore    Float
  snapshotDate   DateTime @db.Date @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
}

// ============================================
// ROADMAP GENERATOR MODELS
// ============================================

model Roadmap {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  roleType    String   // Frontend, Backend, Full Stack, DevOps, Data Science, etc.
  skillLevel  String   @default("beginner") // beginner, intermediate, advanced
  status      String   @default("draft") // draft, in_progress, completed
  topics      Json     // Structured roadmap topics/milestones
  resources   Json     // AI-generated free resources (GFG, YouTube, etc.)
  progress    Float    @default(0) // Overall progress percentage
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  RoadmapMilestone[]

  @@index([userId])
  @@index([roleType])
}

model RoadmapMilestone {
  id          String   @id @default(uuid())
  roadmapId   String
  title       String
  description String
  order       Int
  isCompleted Boolean  @default(false)
  topics      Json     // Array of sub-topics for this milestone
  resources   Json     // Specific resources for this milestone
  dueDate     DateTime?
  completedAt DateTime?

  roadmap     Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
  @@index([order])
}

// ============================================
// ACHIEVEMENT SYSTEM MODELS
// ============================================

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  type        String   // 'algorank_first_solve', 'algorank_streak_7', 'resume_created', 'session_completed', etc.
  title       String
  description String
  icon        String?  // Emoji or icon name
  unlockedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@unique([userId, type])
}
