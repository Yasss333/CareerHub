# Database
DATABASE_URL="postgresql://user:password@localhost:5432/careerhub"
# For Neon, set DATABASE_URL to its pooled (-pooler) URL and DIRECT_URL to its direct URL.
# Local development can use the same local PostgreSQL URL for both.
DIRECT_URL="postgresql://user:password@localhost:5432/careerhub"
PRISMA_CLIENT_ENGINE_TYPE="binary"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
CLIENT_ORIGIN="https://careerhub-navy.vercel.app,http://localhost:5173"
NODE_ENV="development"

# AI Services (for Resume Builder)
OPENROUTER_API_KEY="your-openrouter-api-key"
MODEL_NAME="openai/gpt-4o-mini"
INTERVIEW_ML_URL="http://127.0.0.1:8000"
# Upstream inference timeout, including Whisper transcription (1000-120000 ms).
INTERVIEW_ML_TIMEOUT_MS=30000
# Use direct to call known inference routes without health/OpenAPI discovery.
INTERVIEW_ML_DISCOVERY_MODE="schema"
# Set true only for a deployed verifier that isolates baselines by required session_id.
INTERVIEW_ML_SESSION_SCOPED=false
# Generate a long random value and set the same value in the ML service environment.
INTERVIEW_ML_TOKEN="replace-with-a-long-random-secret"

# ImageKit (for Resume Builder)
IMAGEKIT_PUBLIC_KEY="your-imagekit-public-key"
IMAGEKIT_PRIVATE_KEY="your-imagekit-private-key"
IMAGEKIT_URL_ENDPOINT="your-imagekit-url-endpoint"

# Piston (for AlgoRank)
PISTON_API_URL="http://localhost:2000/api/v2/execute"
PISTON_TIMEOUT=30000

# LiveKit SFU Video Conferencing (In-House Docker / Self-Hosted)
# Default dev credentials when running livekit/livekit-server:latest --dev
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
# Set to 'false' if you want to force Jitsi fallback instead of LiveKit
ENABLE_LIVEKIT=true
